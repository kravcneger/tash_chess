<% content_for :title, t(".title") %>

<div class="page-head">
  <div>
    <h1><%= t(".title") %></h1>
    <p class="muted"><%= t(".subtitle") %></p>
  </div>
  <%= link_to with_icon(:plus, t(".new")), new_tournament_path, class: "btn btn--primary" %>
</div>

<% if @tournaments.any? %>
  <div class="tiles">
    <% @tournaments.each do |tournament| %>
      <article class="tile" id="<%= dom_id(tournament) %>">
        <div class="tile__head">
          <h2 class="tile__title"><%= link_to tournament.name, tournament, class: "stretched-link" %></h2>
          <%= status_badge(tournament) %>
        </div>
        <p class="muted"><%= tournament_summary(tournament) %></p>
        <p class="tile__meta"><%= icon(:users) %> <%= t(".members", count: tournament.participations.size) %></p>
      </article>
    <% end %>
  </div>
<% else %>
  <div class="empty">
    <p><%= t(".empty") %></p>
    <%= link_to with_icon(:plus, t(".create_first")), new_tournament_path, class: "btn btn--primary" %>
  </div>
<% end %>
