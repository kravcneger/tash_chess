<% content_for :title, @tournament.name %>
<%= render "header", tournament: @tournament, tab: :members %>

<% if @tournament.in_progress? && (round = @tournament.current_round) %>
  <div class="callout">
    <span class="callout__text"><span class="live__dot"></span> <%= t(".round_on", number: round.number) %></span>
    <%= link_to with_icon(:swords, t(".see_pairings")), tournament_round_path(@tournament, round), class: "btn btn--small" %>
  </div>
<% end %>

<div class="<%= class_names("layout", "layout--split": @tournament.members_editable?) %>">
  <section class="card card--flush" aria-labelledby="members-title">
    <div class="card__head">
      <h2 id="members-title"><%= t(".members") %></h2>
      <span class="muted"><%= t(".members_count", count: @participations.size) %></span>
    </div>

    <% if @participations.any? %>
      <table class="table">
        <thead>
          <tr>
            <th class="num">#</th>
            <th><%= t(".player") %></th>
            <th class="num">FIDE</th>
            <th class="actions"><span class="visually-hidden"><%= t("shared.actions") %></span></th>
          </tr>
        </thead>
        <tbody>
          <% @participations.each.with_index(1) do |participation, seed| %>
            <% player = participation.player %>
            <tr id="<%= dom_id(participation) %>">
              <td class="num muted"><%= seed %></td>
              <td>
                <%= link_to player.name, player, class: "strong-link" %> <span class="nick">@<%= player.nickname %></span>
                <%= withdrawn_badge if participation.withdrawn? %>
              </td>
              <td class="num"><%= rating(player) %></td>
              <td class="actions">
                <%= link_to icon(:qr_code), tournament_participation_path(@tournament, participation), class: "btn btn--small btn--ghost btn--icon",
                      title: t(".show_code"), aria: { label: t(".show_code_of", name: player.name) } %>
                <% if @tournament.members_editable? %>
                  <% if participation.withdrawn? %>
                    <%= button_to t(".reinstate"), reinstate_tournament_participation_path(@tournament, participation),
                          class: "btn btn--small btn--ghost", aria: { label: t(".reinstate_player", name: player.name) } %>
                  <% elsif @players_with_games.include?(player.id) %>
                    <%= button_to t(".withdraw"), withdraw_tournament_participation_path(@tournament, participation),
                          class: "btn btn--small btn--ghost", aria: { label: t(".withdraw_player", name: player.name) },
                          form: { data: { turbo_confirm: t(".confirm_withdraw", name: player.name) } } %>
                  <% else %>
                    <%= button_to t(".remove"), tournament_participation_path(@tournament, participation), method: :delete,
                          class: "btn btn--small btn--ghost", aria: { label: t(".remove_player", name: player.name) } %>
                  <% end %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <div class="empty empty--inset"><%= t(".no_members") %></div>
    <% end %>
  </section>

  <% if @tournament.members_editable? %>
    <section class="card" id="add-players" aria-labelledby="add-title" data-controller="filter selection" data-selection-label-value="<%= t(".add_selected") %>">
      <div class="card__head card__head--plain">
        <h2 id="add-title"><%= t(".add_players") %></h2>
      </div>
      <% if @tournament.in_progress? %>
        <p class="hint"><%= t(".late_entries.#{@tournament.pairing_system}") %></p>
      <% end %>

      <% if @available_players.any? %>
        <div class="picker__search">
          <%= icon(:search) %>
          <input type="search" class="picker__filter" placeholder="<%= t(".filter_placeholder") %>" autocomplete="off"
                 aria-label="<%= t(".filter_label") %>" data-action="input->filter#apply">
        </div>

        <%= form_with url: tournament_participations_path(@tournament), class: "picker" do |form| %>
          <ul class="picker__list">
            <% @available_players.each do |player| %>
              <li data-filter-target="item" data-filter-text="<%= "#{player.name} #{player.nickname}".downcase %>">
                <label class="picker__item">
                  <%= check_box_tag "player_ids[]", player.id, false, id: dom_id(player, :pick),
                        data: { selection_target: "checkbox", action: "selection#update" } %>
                  <span class="picker__name"><%= player.name %> <span class="nick">@<%= player.nickname %></span></span>
                  <span class="picker__rating"><%= rating(player) %></span>
                </label>
              </li>
            <% end %>
          </ul>
          <p class="picker__none muted" data-filter-target="empty" hidden><%= t(".nobody_matches") %></p>

          <div class="picker__footer">
            <button type="button" class="btn btn--small btn--ghost" data-action="selection#toggleVisible"><%= t(".select_shown") %></button>
            <%= form.button t(".add_selected"), class: "btn btn--primary", disabled: true, data: { selection_target: "submit" } %>
          </div>
        <% end %>
      <% else %>
        <p class="muted"><%= t(".everyone_added") %></p>
      <% end %>

      <p class="picker__new">
        <%= t(".not_in_roster") %> <%= link_to t(".register_player"), new_player_path(tournament_id: @tournament.id), class: "strong-link" %>
      </p>
    </section>
  <% end %>
</div>
