<% content_for :title, "#{t(".round", number: @round.number)} · #{@tournament.name}" %>
<%= render "tournaments/header", tournament: @tournament, tab: :pairings %>

<nav class="rounds" aria-label="<%= t(".rounds") %>">
  <% @tournament.rounds.includes(:games).each do |round| %>
    <%= link_to tournament_round_path(@tournament, round),
          class: class_names("rounds__link", "rounds__link--active": round == @round, "rounds__link--done": round.complete?),
          aria: { current: ("page" if round == @round) }, title: t(round.complete? ? ".complete" : ".in_play") do %>
      <span class="rounds__label"><%= t(".round_label") %></span> <%= round.number %>
    <% end %>
  <% end %>
  <% (@tournament.rounds.size + 1..@tournament.rounds_count.to_i).each do |number| %>
    <span class="rounds__link rounds__link--future" title="<%= t(".not_paired") %>"><span class="rounds__label"><%= t(".round_label") %></span> <%= number %></span>
  <% end %>
</nav>

<% played = @games.count { |game| !game.pending? && !game.bye? } %>
<% playable = @games.count { |game| !game.bye? } %>

<section class="card card--flush pairings" aria-labelledby="round-title">
  <div class="card__head">
    <h2 id="round-title"><%= t(".heading", number: @round.number) %></h2>
    <span class="muted"><%= t(".progress", played:, total: playable) %></span>
  </div>
  <div class="progress" role="progressbar" aria-valuemin="0" aria-valuemax="<%= playable %>" aria-valuenow="<%= played %>">
    <span style="width: <%= playable.zero? ? 100 : (played * 100 / playable) %>%"></span>
  </div>

  <table class="table table--pairings">
    <thead>
      <tr>
        <th class="board-col"><%= t(".board") %></th>
        <th class="side side--white"><%= t("colors.white") %></th>
        <th class="result-col"><%= t(".result") %></th>
        <th class="side side--black"><%= t("colors.black") %></th>
      </tr>
    </thead>
    <tbody>
      <% @games.each do |game| %>
        <tr id="<%= dom_id(game) %>" class="<%= class_names("game", "game--pending": game.pending?, "game--bye": game.bye?) %>">
          <% if game.bye? %>
            <td class="board-col"><span class="board-no board-no--none" title="<%= t(".no_board") %>">—</span></td>
            <td class="side side--white"><%= render "tournaments/rounds/player", player: game.white_player, color: :white, points: @standings[game.white_player]&.points_before(@round.number) %></td>
            <td class="result-col"><span class="bye-label"><%= @tournament.bye_points.positive? ? t(".bye", points: @tournament.bye_points) : t(".rests") %></span></td>
            <td class="side side--black muted">—</td>
          <% else %>
            <td class="board-col"><span class="board-no" title="<%= t(".board_number", number: game.board) %>"><%= game.board %></span></td>
            <td class="<%= class_names("side side--white", outcome_class(game, :white)) %>"><%= render "tournaments/rounds/player", player: game.white_player, color: :white, points: @standings[game.white_player]&.points_before(@round.number) %></td>
            <td class="result-col">
              <% if @tournament.in_progress? %>
                <div class="result-picker" role="group" aria-label="<%= t(".result_of_board", number: game.board) %>">
                  <% Game::RESULT_LABELS.each do |result, label| %>
                    <%= button_to label, game_path(game), method: :patch, params: { game: { result: } },
                          class: class_names("result-btn", "result-btn--active": game.result == result),
                          form_class: "result-picker__form", aria: { pressed: game.result == result } %>
                  <% end %>
                  <% unless game.pending? %>
                    <%= button_to "×", game_path(game), method: :patch, params: { game: { result: "pending" } },
                          class: "result-btn result-btn--clear", form_class: "result-picker__form",
                          title: t(".clear_result"), aria: { label: t(".clear_result_of_board", number: game.board) } %>
                  <% end %>
                </div>
              <% else %>
                <span class="result-final"><%= game.result_label.presence || "–" %></span>
              <% end %>
            </td>
            <td class="<%= class_names("side side--black", outcome_class(game, :black)) %>"><%= render "tournaments/rounds/player", player: game.black_player, color: :black, points: @standings[game.black_player]&.points_before(@round.number) %></td>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
</section>

<div class="round-actions">
  <% if @round == @tournament.current_round && @tournament.can_pair_next_round? %>
    <%= button_to tournament_rounds_path(@tournament), class: "btn btn--primary btn--large" do %>
      <%= with_icon(:shuffle, t(".pair_next", number: @round.number + 1)) %>
    <% end %>
  <% elsif @round == @tournament.current_round && @tournament.can_finish? %>
    <%= button_to finish_tournament_path(@tournament), class: "btn btn--primary btn--large",
          form: { data: { turbo_confirm: t("tournaments.header.confirm_finish") } } do %>
      <%= with_icon(:flag, t("tournaments.header.finish")) %>
    <% end %>
  <% end %>
  <%= link_to with_icon(:list, t("tournaments.header.standings")), tournament_standings_path(@tournament), class: "btn" %>
  <button type="button" class="btn btn--ghost" data-controller="print" data-action="print#print"><%= with_icon(:printer, t(".print")) %></button>
  <% if @tournament.swiss? && @tournament.in_progress? && @round == @tournament.current_round %>
    <%= button_to tournament_round_path(@tournament, @round), method: :delete, class: "btn btn--ghost btn--danger-text",
          form: { data: { turbo_confirm: t(".confirm_delete_round", number: @round.number) } } do %>
      <%= with_icon(:trash, t(".delete_round", number: @round.number)) %>
    <% end %>
  <% end %>
</div>
