<%= turbo_stream_from tournament %>

<header class="tournament-head">
  <div class="page-head">
    <div>
      <p class="crumbs"><%= link_to with_icon(:arrow_left, t("layouts.application.tournaments")), tournaments_path %></p>
      <h1><%= tournament.name %> <%= status_badge(tournament) %></h1>
      <p class="muted"><%= tournament_summary(tournament) %></p>
    </div>

    <div class="toolbar">
      <%= link_to with_icon(:tv, t(".screen")), tournament_screen_path(tournament), class: "btn", target: "_blank", title: t(".screen_hint") %>
      <% if tournament.in_progress? && tab != :members %>
        <%= link_to with_icon(:user_plus, t(".add_player"), label_class: "btn__label--wide"), tournament_path(tournament, anchor: "add-players"),
              class: "btn", aria: { label: t(".add_player") } %>
      <% end %>
      <% unless tournament.finished? %>
        <%= link_to with_icon(:pencil, t("shared.edit"), label_class: "btn__label--wide"), edit_tournament_path(tournament),
              class: "btn", aria: { label: t("shared.edit") } %>
      <% end %>
      <% unless tournament.finished? %>
        <% seconds = countdown_seconds(tournament) %>
        <details class="menu">
          <%= tag.summary class: "btn", title: t(".countdown_hint"), aria: { label: (t(".countdown") unless seconds) } do %>
            <% if seconds %>
              <span class="countdown-badge" data-controller="countdown" data-countdown-seconds-value="<%= seconds %>">
                <%= icon(:timer) %> <span data-countdown-target="time"><%= format_countdown(seconds) %></span>
              </span>
            <% else %>
              <%= with_icon(:timer, t(".countdown"), label_class: "btn__label--wide") %>
            <% end %>
          <% end %>
          <div class="menu__body">
            <%= form_with url: tournament_countdown_path(tournament), class: "countdown-form" do |form| %>
              <%= form.label :minutes, t(".countdown_minutes") %>
              <div class="countdown-form__row">
                <%= form.number_field :minutes, value: 5, min: Tournament::COUNTDOWN_MINUTES.min, max: Tournament::COUNTDOWN_MINUTES.max, required: true %>
                <%= form.button t(".countdown_start"), class: "btn btn--primary" %>
              </div>
              <p class="hint"><%= t(".countdown_hint") %></p>
            <% end %>
            <% if seconds %>
              <%= button_to tournament_countdown_path(tournament), method: :delete, class: "menu__item menu__item--danger" do %>
                <%= with_icon(:x, t(".countdown_cancel")) %>
              <% end %>
            <% end %>
          </div>
        </details>
      <% end %>
      <details class="menu">
        <summary class="btn btn--icon" aria-label="<%= t(".more_actions") %>" title="<%= t(".more_actions") %>"><%= icon(:ellipsis) %></summary>
        <div class="menu__body">
          <% if tournament.can_finish? && tournament.can_pair_next_round? %>
            <%= button_to finish_tournament_path(tournament), class: "menu__item",
                  form: { data: { turbo_confirm: t(".confirm_finish_early") } } do %>
              <%= with_icon(:flag, t(".finish_early")) %>
            <% end %>
          <% end %>
          <% if tournament.can_reset? %>
            <%= button_to reset_tournament_path(tournament), class: "menu__item",
                  form: { data: { turbo_confirm: t(".confirm_reset") } } do %>
              <%= with_icon(:rotate, t(".reset")) %>
            <% end %>
          <% end %>
          <%= button_to tournament, method: :delete, class: "menu__item menu__item--danger",
                form: { data: { turbo_confirm: t(".confirm_delete", name: tournament.name) } } do %>
            <%= with_icon(:trash, t(".delete")) %>
          <% end %>
        </div>
      </details>
      <% if tournament.registration? %>
        <%= button_to start_tournament_path(tournament), class: "btn btn--primary",
              disabled: tournament.participations.size < 2,
              form: { data: { turbo_confirm: t(tournament.round_robin? ? ".confirm_start_all" : ".confirm_start_first") } } do %>
          <%= with_icon(:play, t(".start")) %>
        <% end %>
      <% end %>
      <% if tournament.can_finish? && !tournament.can_pair_next_round? %>
        <%= button_to finish_tournament_path(tournament), class: "btn btn--primary",
              form: { data: { turbo_confirm: t(".confirm_finish") } } do %>
          <%= with_icon(:flag, t(".finish")) %>
        <% end %>
      <% end %>
    </div>
  </div>

  <nav class="tabs" aria-label="<%= t(".sections") %>">
    <%= link_to tournament_path(tournament), class: class_names("tab", "tab--active": tab == :members) do %>
      <%= icon(:users) %> <%= t(".members") %> <span class="tab__count"><%= tournament.participations.size %></span>
    <% end %>
    <% if (round = tournament.current_round) %>
      <%= link_to tournament_round_path(tournament, round), class: class_names("tab", "tab--active": tab == :pairings) do %>
        <%= icon(:swords) %> <%= t(".pairings") %>
      <% end %>
    <% else %>
      <span class="tab tab--disabled" title="<%= t(".pairings_later") %>"><%= icon(:swords) %> <%= t(".pairings") %></span>
    <% end %>
    <%= link_to tournament_standings_path(tournament), class: class_names("tab", "tab--active": tab == :standings) do %>
      <%= icon(:list) %> <%= t(".standings") %>
    <% end %>
  </nav>
</header>
