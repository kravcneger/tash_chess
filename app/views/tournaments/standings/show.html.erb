<% content_for :title, "#{t("tournaments.header.standings")} · #{@tournament.name}" %>
<%= render "tournaments/header", tournament: @tournament, tab: :standings %>

<section class="card card--flush" aria-labelledby="standings-title">
  <div class="card__head">
    <h2 id="standings-title"><%= t(@tournament.finished? ? ".final" : ".current") %></h2>
    <% if @tournament.in_progress? %>
      <span class="live" title="<%= t(".live_hint") %>"><span class="live__dot"></span> <%= t(".live") %></span>
    <% end %>
  </div>

  <% if @standings.rows.any? %>
    <div class="table-scroll">
      <table class="table table--standings">
        <thead>
          <tr>
            <th class="num">#</th>
            <th><%= t(".player") %></th>
            <th class="num">FIDE</th>
            <% 1.upto(@standings.rounds_count) do |number| %>
              <th class="round-cell" title="<%= t("tournaments.rounds.show.round", number:) %>"><%= t(".round_short", number:) %></th>
            <% end %>
            <th class="num points-col"><%= t(".points") %></th>
          </tr>
        </thead>
        <tbody>
          <% @standings.each do |row| %>
            <tr class="<%= class_names("standing", podium_class(row)) %>">
              <td class="num rank"><span class="rank__badge"><%= row.rank %></span></td>
              <td>
                <%= link_to row.player.name, row.player, class: "strong-link" %> <span class="nick">@<%= row.player.nickname %></span>
                <%= withdrawn_badge if @standings.withdrawn?(row.player) %>
              </td>
              <td class="num"><%= rating(row.player) %></td>
              <% row.cells.each do |cell| %>
                <td class="round-cell"><%= standings_cell(cell) %></td>
              <% end %>
              <td class="num points-col"><strong><%= format_score(row.points) %></strong></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="empty empty--inset"><%= t(".no_members") %></div>
  <% end %>
</section>

<p class="hint legend">
  <%= t(@tournament.swiss? ? ".tiebreaks_swiss" : ".tiebreaks_round_robin") %>
  <%= t(".legend_html", white: piece_color(:white), black: piece_color(:black)) %>
</p>
