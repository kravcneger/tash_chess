<%= form_with model: tournament, class: "form", data: { controller: "pairing-form", pairing_form_system_value: tournament.pairing_system } do |form| %>
  <%= render "shared/errors", record: tournament %>

  <div class="field">
    <%= form.label :name %>
    <%= form.text_field :name, required: true, maxlength: 120, autofocus: true, placeholder: t(".name_placeholder") %>
  </div>

  <div class="field-row">
    <div class="field">
      <%= form.label :starts_on %>
      <%= form.date_field :starts_on %>
    </div>
    <div class="field">
      <%= form.label :location %>
      <%= form.text_field :location, maxlength: 120, placeholder: t(".optional") %>
    </div>
  </div>

  <fieldset class="field">
    <legend><%= Tournament.human_attribute_name(:pairing_system) %></legend>
    <% if tournament.new_record? || tournament.registration? %>
      <div class="choices">
        <% Tournament.pairing_systems.each_key do |system| %>
          <label class="choice">
            <%= form.radio_button :pairing_system, system, data: { action: "pairing-form#toggle" } %>
            <span>
              <strong><%= Tournament.human_enum_name(:pairing_system, system) %></strong>
              <span class="hint"><%= t(".pairing_systems.#{system}") %></span>
            </span>
          </label>
        <% end %>
      </div>
    <% else %>
      <p><%= tournament.pairing_system_label %> <span class="hint"><%= t(".pairing_system_locked") %></span></p>
    <% end %>
  </fieldset>

  <div class="field">
    <%= form.label :rounds_count %>
    <%= form.number_field :rounds_count, min: [ 1, tournament.fixed_rounds_count ].max, max: Tournament::MAX_ROUNDS, step: 1,
          class: "input--short", placeholder: t(".rounds_auto"), required: tournament.swiss?,
          data: { pairing_form_target: "rounds" } %>
    <% Tournament.pairing_systems.each_key do |system| %>
      <p class="hint" data-pairing-form-target="hint" data-system="<%= system %>"><%= t(".rounds_hints.#{system}") %></p>
    <% end %>
  </div>

  <div class="field">
    <%= form.label :quiz_url %>
    <%= form.url_field :quiz_url, maxlength: 500, placeholder: t(".optional"), autocomplete: "off" %>
    <p class="hint"><%= t(".quiz_url_hint") %></p>
  </div>

  <div class="form__actions">
    <%= form.submit class: "btn btn--primary" %>
    <%= link_to t("shared.cancel"), tournament.persisted? ? tournament : tournaments_path, class: "btn btn--ghost" %>
  </div>
<% end %>
