<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= [ content_for(:title), "Tash Chess" ].compact.join(" · ") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Tash Chess">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= turbo_refresh_method_tag :morph %>
    <%= turbo_refresh_scroll_tag :preserve %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= render "layouts/fonts" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="topbar">
      <div class="container topbar__inner">
        <%= link_to root_path, class: "brand" do %>
          <%= image_tag "logo.png", class: "brand__mark", alt: "", width: 32, height: 32 %> <span class="brand__name">Tash Chess</span>
        <% end %>
        <nav class="nav">
          <%= nav_link_to with_icon(:trophy, t(".tournaments")), tournaments_path, active: controller_path.start_with?("tournaments") || controller_name == "games" %>
          <%= nav_link_to with_icon(:users, t(".players")), players_path, active: controller_name == "players" %>
        </nav>
        <div class="topbar__end">
          <%= render "layouts/locale_switch" %>
        </div>
      </div>
    </header>

    <main class="container main">
      <%= render "shared/flash" %>
      <%= yield %>
    </main>
  </body>
</html>
