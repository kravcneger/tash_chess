<% content_for :title, t(".title") %>

<div class="page-head">
  <div>
    <h1><%= t(".title") %></h1>
    <p class="muted"><%= t(".count", count: Player.count) %></p>
  </div>
  <%= link_to with_icon(:plus, t(".new")), new_player_path, class: "btn btn--primary" %>
</div>

<%= form_with url: players_path, method: :get, class: "search",
      data: { controller: "auto-submit", turbo_frame: "players", turbo_action: "replace" } do |form| %>
  <%= icon(:search) %>
  <%= form.search_field :query, value: @query, placeholder: t(".search_placeholder"), autocomplete: "off",
        aria: { label: t(".search_label") }, data: { action: "input->auto-submit#submit" } %>
<% end %>

<%= turbo_frame_tag "players", target: "_top" do %>
  <% if @players.any? %>
    <div class="card card--flush">
      <table class="table">
        <thead>
          <tr>
            <th><%= Player.human_attribute_name(:name) %></th>
            <th><%= Player.human_attribute_name(:nickname) %></th>
            <th class="num">FIDE</th>
            <th class="actions"><span class="visually-hidden"><%= t("shared.actions") %></span></th>
          </tr>
        </thead>
        <tbody>
          <% @players.each do |player| %>
            <tr id="<%= dom_id(player) %>">
              <td><%= link_to player.name, player, class: "strong-link" %></td>
              <td class="nick">@<%= player.nickname %></td>
              <td class="num"><%= rating(player) %></td>
              <td class="actions"><%= link_to with_icon(:pencil, t("shared.edit")), edit_player_path(player), class: "btn btn--small btn--ghost" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% elsif @query.present? %>
    <div class="empty"><%= t(".no_matches", query: @query) %></div>
  <% else %>
    <div class="empty">
      <p><%= t(".empty") %></p>
      <%= link_to with_icon(:plus, t(".add_first")), new_player_path, class: "btn btn--primary" %>
    </div>
  <% end %>
<% end %>
