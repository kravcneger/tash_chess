<% content_for :title, @player.name %>

<div class="page-head">
  <div>
    <p class="crumbs"><%= link_to with_icon(:arrow_left, t("layouts.application.players")), players_path %></p>
    <h1><%= @player.name %></h1>
    <p class="muted"><span class="nick">@<%= @player.nickname %></span> · FIDE <%= rating(@player) %></p>
  </div>
  <div class="toolbar">
    <%= link_to with_icon(:pencil, t("shared.edit")), edit_player_path(@player), class: "btn" %>
    <%= button_to @player, method: :delete, class: "btn btn--danger",
          form: { data: { turbo_confirm: t(".confirm_delete", name: @player.name) } } do %>
      <%= with_icon(:trash, t("shared.delete")) %>
    <% end %>
  </div>
</div>

<section class="card">
  <h2><%= t(".tournaments") %></h2>
  <% if @tournaments.any? %>
    <ul class="list">
      <% @tournaments.each do |tournament| %>
        <li class="list__item">
          <%= link_to tournament.name, tournament, class: "strong-link" %>
          <span class="muted"><%= tournament_summary(tournament) %></span>
          <span class="list__end">
            <% unless tournament.registration? %>
              <span class="score"><%= t(".points", points: format_score(tournament.standings[@player]&.points)) %></span>
            <% end %>
            <%= status_badge(tournament) %>
          </span>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="muted"><%= t(".no_tournaments") %></p>
  <% end %>
</section>
